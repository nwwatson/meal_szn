<%# locals: (day:, daily_calories_target:) %>
<%
  total_cal = day.total_calories
  total_fat = day.total_fat
  total_protein = day.total_protein
  total_carbs = day.total_net_carbs
  status = calorie_status(total_cal, daily_calories_target)
%>
<div class="flex flex-wrap items-center gap-3 text-sm">
  <% if status %>
    <div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold <%= status[:bg] %> <%= status[:text] %> <%= status[:border] %> border">
      <%= total_cal %> / <%= daily_calories_target %> cal
      <span class="<%= status[:text] %>"><%= status[:label] %></span>
    </div>
  <% else %>
    <span class="text-sm font-semibold text-warm-700 tabular-nums"><%= total_cal %> cal</span>
  <% end %>
  <div class="flex gap-3 text-xs text-warm-500 tabular-nums">
    <span>F:<%= total_fat %>g</span>
    <span>P:<%= total_protein %>g</span>
    <span>C:<%= total_carbs %>g</span>
  </div>
</div>
