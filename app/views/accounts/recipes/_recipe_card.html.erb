<%= link_to recipe_path(recipe), class: "block bg-white rounded-2xl overflow-hidden recipe-card-hover group",
    data: { controller: "recipe-card", recipe_card_index_value: index } do %>
  <div class="relative h-40 overflow-hidden">
    <% if recipe.image.attached? %>
      <%= image_tag recipe.image.variant(resize_to_fill: [600, 300]),
          class: "w-full h-full object-cover recipe-card-image",
          loading: "lazy", alt: recipe.title %>
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
    <% else %>
      <% visuals = RecipesHelper::CATEGORY_VISUALS[recipe.category] || RecipesHelper::CATEGORY_VISUALS["dinner"] %>
      <div class="w-full h-full bg-gradient-to-br <%= visuals[:gradient] %> recipe-card-image flex items-center justify-center">
        <svg class="w-12 h-12 opacity-15 text-warm-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <%= raw(icon_path(visuals[:icon])) %>
        </svg>
      </div>
    <% end %>
    <%# Overlays on image %>
    <div class="absolute top-3 left-3 flex gap-2">
      <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white/90 text-warm-800 backdrop-blur-sm shadow-sm">
        <%= recipe.category.titleize %>
      </span>
    </div>
    <% if recipe.total_time > 0 %>
      <div class="absolute top-3 right-3">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-black/50 text-white backdrop-blur-sm">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
          </svg>
          <%= recipe.total_time %> min
        </span>
      </div>
    <% end %>
  </div>

  <div class="p-4">
    <h2 class="text-base font-display font-bold text-warm-900 group-hover:text-primary-700 transition-colors mb-1 line-clamp-1"><%= recipe.title %></h2>
    <% if recipe.description.present? %>
      <p class="text-warm-500 text-sm mb-3 line-clamp-2"><%= recipe.description %></p>
    <% end %>

    <%# Nutrition summary row %>
    <% if recipe.nutrition_data %>
      <div class="flex items-center gap-3 text-xs text-warm-500 mb-2">
        <span class="font-semibold text-warm-700"><%= recipe.nutrition_data.calories %> cal</span>
        <span>F: <%= recipe.nutrition_data.fat.to_i %>g</span>
        <span>P: <%= recipe.nutrition_data.protein.to_i %>g</span>
        <span>C: <%= recipe.nutrition_data.net_carbs.to_i %>g</span>
      </div>
    <% end %>

    <%# Diet badges %>
    <% if recipe.nutrition_data %>
      <% if (badges = diet_score_badges(recipe.nutrition_data)) %>
        <div class="flex gap-1 flex-wrap mb-2"><%= badges %></div>
      <% end %>
    <% end %>

    <%# Non-diet tags %>
    <% non_diet_tags = recipe.tags.reject { |t| t.name.start_with?("diet:") } %>
    <% if non_diet_tags.any? %>
      <div class="flex gap-1 flex-wrap">
        <% non_diet_tags.first(3).each do |tag| %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-primary-50 text-primary-700"><%= tag.name %></span>
        <% end %>
        <% if non_diet_tags.size > 3 %>
          <span class="text-xs text-warm-400">+<%= non_diet_tags.size - 3 %></span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
