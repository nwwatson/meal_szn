<% if @active_filters %>
  <%# Filtered empty state %>
  <div class="text-center py-16">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-warm-100 mb-4">
      <svg class="w-8 h-8 text-warm-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
      </svg>
    </div>
    <h2 class="text-lg font-display font-bold text-warm-800 mb-2">No recipes match your filters</h2>
    <p class="text-warm-500 text-sm mb-4">Try adjusting your search or filters to find what you're looking for.</p>
    <%= link_to "Clear all filters", recipes_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors" %>
  </div>
<% else %>
  <%# No recipes at all — onboarding %>
  <div class="text-center py-16">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-accent-50 mb-6">
      <svg class="w-10 h-10 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/>
      </svg>
    </div>
    <h2 class="text-2xl font-display font-bold text-warm-900 mb-2">Start your recipe collection</h2>
    <p class="text-warm-500 mb-8 max-w-md mx-auto">Add recipes to build your meal planning library. Import from the web, snap a photo, or describe what you want.</p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-2xl mx-auto">
      <%= link_to import_url_recipes_path, class: "card-warm rounded-xl p-5 text-center hover:shadow-md transition-shadow group" do %>
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary-50 mb-3 group-hover:bg-primary-100 transition-colors">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m9.86-2.556a4.5 4.5 0 0 0-1.242-7.244l4.5-4.5a4.5 4.5 0 0 1 6.364 6.364l-1.757 1.757"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-warm-800 mb-1">Import URL</h3>
        <p class="text-warm-500 text-xs">Paste a recipe link</p>
      <% end %>

      <%= link_to import_photo_recipes_path, class: "card-warm rounded-xl p-5 text-center hover:shadow-md transition-shadow group" do %>
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary-50 mb-3 group-hover:bg-primary-100 transition-colors">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-warm-800 mb-1">Snap a Photo</h3>
        <p class="text-warm-500 text-xs">Upload a recipe image</p>
      <% end %>

      <%= link_to quick_entry_recipes_path, class: "card-warm rounded-xl p-5 text-center hover:shadow-md transition-shadow group" do %>
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary-50 mb-3 group-hover:bg-primary-100 transition-colors">
          <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456Z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-warm-800 mb-1">Quick Entry</h3>
        <p class="text-warm-500 text-xs">Describe it, AI builds it</p>
      <% end %>
    </div>
  </div>
<% end %>
