<% content_for(:title, "Recipes - MealSzn") %>

<div class="recipe-browser-bg min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <%# Header: count + add recipe dropdown %>
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-3xl font-display font-bold text-warm-900">Recipes</h1>
        <p class="text-warm-500 text-sm mt-1"><%= @recipe_count %> <%= "recipe".pluralize(@recipe_count) %></p>
      </div>
      <div data-controller="dropdown" class="relative">
        <button data-action="click->dropdown#toggle" class="bg-primary-600 text-white py-2.5 px-5 rounded-xl hover:bg-primary-700 font-medium transition-colors inline-flex items-center gap-2 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
          </svg>
          Add Recipe
        </button>
        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-warm-200 py-2 z-20">
          <%= link_to new_recipe_path, class: "block px-4 py-2.5 text-sm text-warm-700 hover:bg-warm-50 transition-colors" do %>
            <span class="font-medium">New Recipe</span>
            <span class="block text-warm-400 text-xs">Create from scratch</span>
          <% end %>
          <%= link_to import_url_recipes_path, class: "block px-4 py-2.5 text-sm text-warm-700 hover:bg-warm-50 transition-colors" do %>
            <span class="font-medium">Import from URL</span>
            <span class="block text-warm-400 text-xs">Paste a recipe link</span>
          <% end %>
          <%= link_to import_photo_recipes_path, class: "block px-4 py-2.5 text-sm text-warm-700 hover:bg-warm-50 transition-colors" do %>
            <span class="font-medium">Import from Photo</span>
            <span class="block text-warm-400 text-xs">Upload a recipe image</span>
          <% end %>
          <%= link_to quick_entry_recipes_path, class: "block px-4 py-2.5 text-sm text-warm-700 hover:bg-warm-50 transition-colors" do %>
            <span class="font-medium">Quick Entry</span>
            <span class="block text-warm-400 text-xs">Describe it, AI builds it</span>
          <% end %>
        </div>
      </div>
    </div>

    <%# Search bar %>
    <div data-controller="recipe-search" class="mb-6">
      <%= form_with url: recipes_path, method: :get, data: { recipe_search_target: "form" }, class: "relative" do |f| %>
        <%# Preserve existing filter params %>
        <% %w[category diet sort cook_time min_calories max_calories].each do |p| %>
          <%= hidden_field_tag p, params[p] if params[p].present? %>
        <% end %>
        <% Array(params[:tags]).each do |tag_id| %>
          <%= hidden_field_tag "tags[]", tag_id %>
        <% end %>

        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-warm-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
          </svg>
          <input type="text" name="q" value="<%= params[:q] %>"
                 placeholder="Search recipes by name, description, or ingredient..."
                 autocomplete="off"
                 data-recipe-search-target="input"
                 data-action="input->recipe-search#search"
                 class="w-full pl-12 pr-10 py-3 rounded-xl border border-warm-200 bg-white/80 backdrop-blur text-warm-900 placeholder-warm-400 search-glow focus:outline-none transition-all text-sm">
          <% if params[:q].present? %>
            <button type="button" data-action="click->recipe-search#clear" class="absolute right-3 top-1/2 -translate-y-1/2 text-warm-400 hover:text-warm-600 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
              </svg>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Filter toggle + sort %>
    <div data-controller="recipe-filter">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <button data-action="click->recipe-filter#togglePanel" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium text-warm-700 bg-white/70 border border-warm-200 hover:bg-white transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
          </svg>
          Filters
          <% filter_count = active_filter_count %>
          <% if filter_count > 0 %>
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary-600 text-white text-xs font-bold"><%= filter_count %></span>
          <% end %>
        </button>

        <% if @active_filters %>
          <button data-action="click->recipe-filter#clearAll" class="text-sm text-primary-600 hover:text-primary-800 font-medium transition-colors">
            Clear all
          </button>
        <% end %>
      </div>

      <%# Sort dropdown %>
      <%= form_with url: recipes_path, method: :get, class: "inline-flex" do |f| %>
        <% %w[q category diet cook_time min_calories max_calories].each do |p| %>
          <%= hidden_field_tag p, params[p] if params[p].present? %>
        <% end %>
        <% Array(params[:tags]).each do |tag_id| %>
          <%= hidden_field_tag "tags[]", tag_id %>
        <% end %>
        <select name="sort" onchange="this.form.requestSubmit()" class="text-sm border border-warm-200 rounded-lg px-3 py-2 bg-white/70 text-warm-700 focus:outline-none focus:border-primary-400 cursor-pointer">
          <% sort_options.each do |label, value| %>
            <option value="<%= value %>" <%= "selected" if params[:sort] == value %>><%= label %></option>
          <% end %>
        </select>
      <% end %>
    </div>

    <%# Collapsible filter panel %>
    <div data-recipe-filter-target="panel" class="filter-panel mb-6">
      <div class="card-warm rounded-2xl p-5 space-y-5">

        <%# Category pills %>
        <div>
          <span class="text-xs font-semibold text-warm-500 uppercase tracking-wider mb-2 block">Category</span>
          <div class="flex gap-2 flex-wrap">
            <%= link_to "All", recipes_path(filter_params_except(:category)),
                  class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:category].blank? ? 'bg-primary-600 text-white shadow-sm' : 'bg-warm-100 text-warm-700 hover:bg-warm-200'}" %>
            <% @categories.each do |label, value, count| %>
              <%= link_to "#{label} (#{count})", recipes_path(filter_params_with(category: value)),
                    class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{params[:category] == value ? 'bg-primary-600 text-white shadow-sm' : 'bg-warm-100 text-warm-700 hover:bg-warm-200'}" %>
            <% end %>
          </div>
        </div>

        <%# Diet pills %>
        <% if @diet_filters.any? %>
          <div>
            <span class="text-xs font-semibold text-warm-500 uppercase tracking-wider mb-2 block">Diet</span>
            <div class="flex gap-2 flex-wrap">
              <% if params[:diet].present? %>
                <%= link_to "All Diets", recipes_path(filter_params_except(:diet)),
                      class: "px-3 py-1.5 rounded-full text-sm font-medium bg-warm-100 text-warm-700 hover:bg-warm-200 transition-colors" %>
              <% end %>
              <% @diet_filters.each do |label, slug| %>
                <% selected = params[:diet] == slug %>
                <% style = NutritionHelper::DIET_BADGE_STYLES[slug] %>
                <%= link_to label, recipes_path(filter_params_with(diet: slug)),
                      class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{selected ? "#{style[:bg]} #{style[:text]} ring-1 ring-current" : 'bg-warm-100 text-warm-700 hover:bg-warm-200'}" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Tag pills %>
        <% if @tags.any? %>
          <div>
            <span class="text-xs font-semibold text-warm-500 uppercase tracking-wider mb-2 block">Tags</span>
            <div class="flex gap-2 flex-wrap">
              <% @tags.each do |tag| %>
                <% next if tag.name.start_with?("diet:") %>
                <% selected = Array(params[:tags]).include?(tag.id) %>
                <% new_tags = selected ? Array(params[:tags]) - [tag.id] : Array(params[:tags]) + [tag.id] %>
                <%= link_to recipes_path(filter_params_with(tags: new_tags.presence)),
                      class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{selected ? 'bg-primary-100 text-primary-800 ring-1 ring-primary-600' : 'bg-warm-100 text-warm-700 hover:bg-warm-200'}" do %>
                  <%= tag.name %> (<%= tag.recipe_count %>)
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Cook time quick buttons + calorie range %>
        <div class="flex flex-col sm:flex-row gap-5">
          <div class="flex-1">
            <span class="text-xs font-semibold text-warm-500 uppercase tracking-wider mb-2 block">Cook Time</span>
            <div class="flex gap-2 flex-wrap">
              <% cook_time_options.each do |label, value| %>
                <% selected = params[:cook_time].to_s == value.to_s %>
                <% link_params = value ? filter_params_with(cook_time: value) : filter_params_except(:cook_time) %>
                <%= link_to label, recipes_path(link_params),
                      class: "px-3 py-1.5 rounded-full text-sm font-medium transition-colors #{selected ? 'bg-primary-600 text-white shadow-sm' : 'bg-warm-100 text-warm-700 hover:bg-warm-200'}" %>
              <% end %>
            </div>
          </div>

          <div class="flex-1">
            <span class="text-xs font-semibold text-warm-500 uppercase tracking-wider mb-2 block">Calories per Serving</span>
            <%= form_with url: recipes_path, method: :get, class: "flex items-center gap-2" do %>
              <% %w[q category diet sort cook_time].each do |p| %>
                <%= hidden_field_tag p, params[p] if params[p].present? %>
              <% end %>
              <% Array(params[:tags]).each do |tag_id| %>
                <%= hidden_field_tag "tags[]", tag_id %>
              <% end %>
              <input type="number" name="min_calories" value="<%= params[:min_calories] %>" placeholder="Min" min="0" step="50"
                     class="w-20 px-2 py-1.5 rounded-lg border border-warm-200 bg-white text-sm text-warm-700 focus:outline-none focus:border-primary-400">
              <span class="text-warm-400">–</span>
              <input type="number" name="max_calories" value="<%= params[:max_calories] %>" placeholder="Max" min="0" step="50"
                     class="w-20 px-2 py-1.5 rounded-lg border border-warm-200 bg-white text-sm text-warm-700 focus:outline-none focus:border-primary-400">
              <button type="submit" class="px-3 py-1.5 rounded-lg bg-primary-600 text-white text-sm font-medium hover:bg-primary-700 transition-colors">Go</button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    </div>

    <%# Active filter summary %>
    <% if @active_filters %>
      <div class="flex items-center gap-2 mb-4 flex-wrap text-sm">
        <span class="text-warm-500 font-medium">Showing:</span>
        <% if params[:q].present? %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-primary-700 font-medium">
            "<%= params[:q] %>"
            <%= link_to recipes_path(filter_params_except(:q)), class: "hover:text-primary-900" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
            <% end %>
          </span>
        <% end %>
        <% if params[:category].present? %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-primary-700 font-medium">
            <%= params[:category].titleize %>
            <%= link_to recipes_path(filter_params_except(:category)), class: "hover:text-primary-900" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
            <% end %>
          </span>
        <% end %>
        <% if params[:diet].present? %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-primary-700 font-medium">
            <%= NutritionHelper::DIET_BADGE_STYLES.dig(params[:diet], :label) || params[:diet] %>
            <%= link_to recipes_path(filter_params_except(:diet)), class: "hover:text-primary-900" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
            <% end %>
          </span>
        <% end %>
        <% if params[:cook_time].present? %>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-primary-700 font-medium">
            ≤ <%= params[:cook_time] %> min
            <%= link_to recipes_path(filter_params_except(:cook_time)), class: "hover:text-primary-900" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
            <% end %>
          </span>
        <% end %>
      </div>
    <% end %>

    <%# Recipe grid %>
    <% if @recipes.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @recipes.each_with_index do |recipe, index| %>
          <%= render "recipe_card", recipe: recipe, index: index %>
        <% end %>

        <%# Load More via lazy Turbo Frame %>
        <% if @pagy.next %>
          <%= turbo_frame_tag "recipes_page_#{@pagy.next}", loading: :lazy, src: recipes_path(page: @pagy.next, **filter_params), class: "col-span-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" do %>
            <div class="flex justify-center py-8 col-span-full">
              <div class="inline-flex items-center gap-2 text-warm-400 text-sm">
                <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                </svg>
                Loading more recipes...
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

    <% else %>
      <%= render "empty_state" %>
    <% end %>

  </div>
</div>
