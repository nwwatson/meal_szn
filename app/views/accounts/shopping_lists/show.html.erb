<% content_for(:title, "#{@shopping_list.name || 'Shopping List'} - MealSzn") %>

<% unchecked = @shopping_list.items.unchecked.alphabetical %>
<% checked = @shopping_list.items.checked.alphabetical %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8" data-controller="shopping-list clipboard">
  <div class="mb-6 flex items-center justify-between">
    <%= link_to "&larr; Back to Meal Plan".html_safe, meal_plan_path(@meal_plan), class: "text-primary-600 hover:text-primary-700 text-sm font-medium" %>

    <%# Copy list button %>
    <div class="relative">
      <button type="button"
              data-action="clipboard#copy"
              class="inline-flex items-center gap-1.5 bg-warm-100 text-warm-700 px-3 py-1.5 rounded-lg hover:bg-warm-200 text-sm font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9.75a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
        </svg>
        Copy List
      </button>
      <span data-clipboard-target="feedback"
            class="hidden absolute -top-8 left-1/2 -translate-x-1/2 bg-warm-800 text-white text-xs px-2 py-1 rounded whitespace-nowrap transition-opacity duration-300">
        Copied!
      </span>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-warm-200">
    <%# Header with progress %>
    <div class="p-5 border-b border-warm-200">
      <div class="flex justify-between items-start">
        <div>
          <h1 class="text-2xl font-display font-bold text-warm-900"><%= @shopping_list.name || "Shopping List" %></h1>
          <p class="text-sm text-warm-500 mt-1" data-shopping-list-target="statusText">
            <%= @shopping_list.checked_count %> of <%= @shopping_list.total_count %> items checked
          </p>
        </div>
        <div class="flex gap-2">
          <%= button_to "Regenerate", meal_plan_shopping_list_path(@meal_plan), method: :post, class: "bg-warm-100 text-warm-700 px-3 py-1.5 rounded-lg hover:bg-warm-200 text-sm font-medium transition-colors", data: { turbo_confirm: "This will replace the current shopping list. Continue?" } %>
          <%= button_to "Delete", meal_plan_shopping_list_path(@meal_plan), method: :delete, class: "bg-red-50 text-red-600 px-3 py-1.5 rounded-lg hover:bg-red-100 text-sm font-medium transition-colors", data: { turbo_confirm: "Delete this shopping list?" } %>
        </div>
      </div>

      <% if @shopping_list.total_count > 0 %>
        <div class="mt-3 w-full bg-warm-200 rounded-full h-2.5">
          <div data-shopping-list-target="progressBar"
               class="bg-primary-500 h-2.5 rounded-full transition-all duration-500 ease-out"
               style="width: <%= (@shopping_list.checked_count.to_f / @shopping_list.total_count * 100).round %>%"></div>
        </div>
      <% end %>
    </div>

    <%# Unchecked items — "To Buy" %>
    <div data-shopping-list-target="uncheckedSection"
         class="<%= unchecked.empty? ? 'hidden' : '' %> <%= checked.any? ? 'border-b border-warm-200' : '' %>">
      <div class="px-5 pt-5 pb-2">
        <h2 data-shopping-list-target="uncheckedCount"
            class="text-sm font-semibold text-warm-500 uppercase tracking-wider">To Buy (<%= unchecked.size %>)</h2>
      </div>
      <div data-shopping-list-target="uncheckedList" data-clipboard-target="source">
        <% unchecked.each do |item| %>
          <div data-item-row
               data-toggle-url="<%= toggle_shopping_list_item_path(item) %>"
               data-item-id="<%= item.id %>"
               data-action="click->shopping-list#toggleItem"
               role="button"
               tabindex="0"
               class="flex items-center gap-4 px-5 py-3 min-h-[48px] cursor-pointer select-none active:bg-warm-50 transition-all duration-200">
            <span data-checkbox
                  class="shrink-0 w-7 h-7 border-2 border-warm-300 rounded-lg flex items-center justify-center transition-colors duration-200">
            </span>
            <span data-item-text class="text-warm-900 text-base flex-1"><%= item.display_text %></span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Checked items %>
    <div data-shopping-list-target="checkedSection"
         class="<%= checked.empty? ? 'hidden' : '' %>">
      <div class="px-5 pt-5 pb-2">
        <h2 data-shopping-list-target="checkedCount"
            class="text-sm font-semibold text-warm-500 uppercase tracking-wider">Checked Off (<%= checked.size %>)</h2>
      </div>
      <div data-shopping-list-target="checkedList" class="pb-3">
        <% checked.each do |item| %>
          <div data-item-row
               data-toggle-url="<%= toggle_shopping_list_item_path(item) %>"
               data-item-id="<%= item.id %>"
               data-action="click->shopping-list#toggleItem"
               role="button"
               tabindex="0"
               class="flex items-center gap-4 px-5 py-3 min-h-[48px] cursor-pointer select-none active:bg-warm-50 transition-all duration-200">
            <span data-checkbox
                  class="shrink-0 w-7 h-7 border-2 border-primary-500 bg-primary-500 rounded-lg flex items-center justify-center transition-colors duration-200">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            <span data-item-text class="text-warm-400 line-through text-base flex-1"><%= item.display_text %></span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Pending sync indicator (shown when offline toggles are queued) %>
    <div id="sync-pending-banner" class="hidden px-5 py-2 bg-accent-50 border-b border-accent-200 text-accent-700 text-sm flex items-center gap-2">
      <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      Changes will sync when you're back online
    </div>

    <% if @shopping_list.items.empty? %>
      <div class="p-8 text-center text-warm-500">
        <svg class="w-12 h-12 mx-auto mb-3 text-warm-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
        </svg>
        <p class="font-medium">No items in this shopping list.</p>
        <p class="text-sm mt-1">Generate items from your meal plan.</p>
      </div>
    <% end %>
  </div>
</div>
