<%# Mobile bottom navigation bar — hidden on md+ screens %>
<nav class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-white border-t border-warm-200 shadow-[0_-2px_10px_rgba(0,0,0,0.06)]"
     style="padding-bottom: env(safe-area-inset-bottom, 0px);"
     data-controller="bottom-nav"
     data-action="keydown@window->bottom-nav#closeOnEscape">

  <div class="flex items-end justify-around h-16 px-2">
    <%# Dashboard %>
    <%= bottom_nav_tab "Dashboard", account_root_path,
        controller_match: %w[dashboards],
        icon: "M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" %>

    <%# Recipes %>
    <%= bottom_nav_tab "Recipes", recipes_path,
        controller_match: %w[recipes],
        icon: "M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" %>

    <%# Center "+" quick-create button %>
    <div class="relative flex flex-col items-center" data-bottom-nav-target="quickCreateWrap">
      <button type="button"
              data-action="bottom-nav#toggleQuickCreate"
              data-bottom-nav-target="quickCreateBtn"
              class="flex items-center justify-center w-12 h-12 -mt-4 rounded-full bg-primary-600 text-white shadow-lg shadow-primary-600/30 active:scale-95 transition-transform duration-150">
        <svg class="w-6 h-6 transition-transform duration-200" data-bottom-nav-target="plusIcon" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </button>
      <span class="text-[10px] mt-0.5 text-warm-400 font-medium">New</span>

      <%# Quick-create popover %>
      <div data-bottom-nav-target="popover"
           class="hidden absolute bottom-full mb-3 w-48 rounded-xl bg-white shadow-xl ring-1 ring-warm-200 overflow-hidden origin-bottom scale-95 opacity-0 transition-all duration-200">
        <div class="py-1">
          <%= link_to new_recipe_path, class: "flex items-center gap-3 px-4 py-3 text-sm text-warm-700 hover:bg-warm-50 transition-colors" do %>
            <svg class="w-5 h-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            New Recipe
          <% end %>
          <div class="border-t border-warm-100"></div>
          <%= link_to new_meal_plan_path, class: "flex items-center gap-3 px-4 py-3 text-sm text-warm-700 hover:bg-warm-50 transition-colors" do %>
            <svg class="w-5 h-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            New Meal Plan
          <% end %>
        </div>
      </div>
    </div>

    <%# Meal Plans %>
    <%= bottom_nav_tab "Plans", meal_plans_path,
        controller_match: %w[meal_plans meal_plan_meals shopping_lists shopping_list_items],
        icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" %>

    <%# Family %>
    <%= bottom_nav_tab "Family", dietary_profiles_path,
        controller_match: %w[dietary_profiles],
        icon: "M18 18.72a9.094 9.094 0 003.741-2.706 9.042 9.042 0 00-7.741-3.764 9.042 9.042 0 00-7.741 3.764 9.094 9.094 0 003.741 2.706M12 6.75a3.75 3.75 0 110 7.5 3.75 3.75 0 010-7.5zM12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25z" %>
  </div>
</nav>
