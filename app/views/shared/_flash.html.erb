<div class="fixed top-4 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none">
  <% if flash[:notice] %>
    <div data-controller="flash"
         class="pointer-events-auto flex items-center gap-3 px-5 py-3 rounded-xl shadow-lg border border-green-200 bg-green-50 text-green-800 text-sm font-medium opacity-0 translate-y-[-1rem] transition-all duration-300 ease-out">
      <svg class="w-5 h-5 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span><%= flash[:notice] %></span>
      <button type="button" data-action="flash#close" class="ml-2 text-green-400 hover:text-green-600 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  <% end %>

  <% if flash[:alert] %>
    <div data-controller="flash"
         class="pointer-events-auto flex items-center gap-3 px-5 py-3 rounded-xl shadow-lg border border-red-200 bg-red-50 text-red-800 text-sm font-medium opacity-0 translate-y-[-1rem] transition-all duration-300 ease-out">
      <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span><%= flash[:alert] %></span>
      <button type="button" data-action="flash#close" class="ml-2 text-red-400 hover:text-red-600 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  <% end %>
</div>
