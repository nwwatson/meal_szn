<% content_for(:title, "Link Expired - MealSzn") %>

<div class="text-center">
  <div class="text-4xl mb-4">⏰</div>
  <h2 class="font-display font-bold text-2xl text-warm-900 mb-2">Link Expired</h2>
  <p class="text-warm-600 mb-6">
    This recipe share link has expired. Ask <strong><%= @recipe_share.sender_name %></strong> to send you a new one.
  </p>
  <%= link_to "Go to MealSzn", new_session_path, class: "inline-block px-6 py-2 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700" %>
</div>
