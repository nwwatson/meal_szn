<!DOCTYPE html>
<html>
<head>
  <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #fdfbf7; margin: 0; padding: 20px;">
  <div style="max-width: 560px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
    <div style="background: linear-gradient(135deg, #7d381c, #c2582a); padding: 24px 32px;">
      <h1 style="color: #ffffff; margin: 0; font-size: 22px;">
        <%= @sender.name %> shared a recipe with you
      </h1>
    </div>

    <div style="padding: 32px;">
      <div style="background: #fdfbf7; border-radius: 8px; padding: 20px; margin-bottom: 24px; border: 1px solid #ede4d9;">
        <h2 style="margin: 0 0 8px; font-size: 20px; color: #2a1c13;"><%= @recipe.title %></h2>
        <% if @recipe.description.present? %>
          <p style="margin: 0 0 12px; color: #6b5a42; font-size: 14px; line-height: 1.5;">
            <%= truncate(@recipe.description, length: 200) %>
          </p>
        <% end %>
        <div style="display: flex; gap: 12px; font-size: 13px; color: #8a7a66;">
          <span><%= @recipe.category.titleize %></span>
          <% if @recipe.total_time > 0 %>
            <span>&bull; <%= @recipe.total_time %> min</span>
          <% end %>
          <% if @recipe.servings %>
            <span>&bull; <%= @recipe.servings %> servings</span>
          <% end %>
        </div>
      </div>

      <div style="text-align: center; margin-bottom: 24px;">
        <a href="<%= @share_url %>"
           style="display: inline-block; background: #c2582a; color: #ffffff; padding: 14px 32px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 16px;">
          View Recipe &amp; Add to My Collection
        </a>
      </div>

      <p style="font-size: 13px; color: #8a7a66; text-align: center; margin: 0;">
        This link expires in 30 days. If you didn't expect this email, you can safely ignore it.
      </p>
    </div>
  </div>
</body>
</html>
