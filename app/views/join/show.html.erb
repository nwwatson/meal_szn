<% content_for(:title, "Join an Account - MealSzn") %>

<h2 class="text-2xl font-display font-bold text-warm-900 mb-2">Join an Account</h2>
<p class="text-warm-500 text-sm mb-6">Enter a join code to join a family's meal planning account.</p>

<% if @account %>
  <%# Code was valid — show confirmation %>
  <div class="mb-6 p-4 bg-primary-50 border border-primary-200 rounded-lg">
    <p class="text-sm text-primary-800 font-medium">You're about to join <strong><%= @account.name %></strong></p>
  </div>

  <% if @has_existing_account %>
    <div class="mb-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <p class="text-sm text-yellow-800">You currently belong to another account. Joining this one will remove you from your current account. Any recipes you want to keep should be selected from your current account's leave page first.</p>
    </div>
  <% end %>

  <%= form_with url: join_path, method: :post do |f| %>
    <%= f.hidden_field :code, value: @code %>
    <%= f.submit "Join #{@account.name}", class: "w-full bg-primary-600 text-white px-4 py-3 rounded-lg hover:bg-primary-700 transition-colors font-medium cursor-pointer" %>
  <% end %>
<% else %>
  <%# No code or invalid code — show entry form %>
  <% if @code.present? %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-sm text-red-700">That join code is invalid or has expired.</p>
    </div>
  <% end %>

  <%= form_with url: join_path, method: :get, class: "space-y-4" do |f| %>
    <div>
      <label for="code" class="block text-sm font-medium text-warm-700 mb-1">Join Code</label>
      <input type="text" name="code" id="code" placeholder="XXXX-XXXX-XXXX" class="w-full rounded-lg border-warm-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 text-center text-lg tracking-widest font-mono" autocomplete="off">
    </div>
    <button type="submit" class="w-full bg-primary-600 text-white px-4 py-3 rounded-lg hover:bg-primary-700 transition-colors font-medium">
      Look Up Code
    </button>
  <% end %>
<% end %>

<div class="mt-6 text-center">
  <p class="text-sm text-warm-500">Don't have a code? <%= link_to "Create your own account", new_signup_path, class: "text-primary-600 hover:text-primary-700 font-medium" %></p>
</div>
