<% content_for(:title, "Accept Invitation - MealSzn") %>

<h2 class="text-2xl font-display font-bold text-warm-900 mb-2">You're Invited!</h2>

<% if @invitation.redeemable? %>
  <div class="mb-6 p-4 bg-primary-50 border border-primary-200 rounded-lg">
    <p class="text-sm text-primary-800"><strong><%= @invitation.invited_by.name %></strong> invited you to join <strong><%= @invitation.account.name %></strong> on MealSzn.</p>
  </div>

  <% if @has_existing_account %>
    <div class="mb-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <p class="text-sm text-yellow-800">You currently belong to <strong><%= @existing_account.name %></strong>. Joining this account will remove you from your current one. If you have recipes you'd like to keep, go to your current account and use the "Leave Account" option to select recipes first.</p>
    </div>
  <% end %>

  <% if Current.identity.pending_recipe_transfers.any? %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg">
      <p class="text-sm text-green-800">You have <strong><%= Current.identity.pending_recipe_transfers.count %></strong> recipes ready to transfer. They will be merged into your new account when you join.</p>
    </div>
  <% end %>

  <%= form_with url: invitation_acceptance_path(token: @invitation.token), method: :patch do |f| %>
    <%= f.submit "Join #{@invitation.account.name}", class: "w-full bg-primary-600 text-white px-4 py-3 rounded-lg hover:bg-primary-700 transition-colors font-medium cursor-pointer" %>
  <% end %>
<% else %>
  <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
    <p class="text-sm text-red-700">
      <% if @invitation.accepted? %>
        This invitation has already been used.
      <% else %>
        This invitation has expired.
      <% end %>
    </p>
  </div>
<% end %>

<div class="mt-6 text-center">
  <p class="text-sm text-warm-500"><%= link_to "Sign in to a different account", new_session_path, class: "text-primary-600 hover:text-primary-700 font-medium" %></p>
</div>
