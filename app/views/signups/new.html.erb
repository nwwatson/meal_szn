<% content_for(:title, "Sign up - MealSzn") %>

<%# Hero override for sign-up page %>
<% content_for(:hero_content) do %>
  <li class="flex items-start gap-3 text-primary-100/90">
    <span class="text-accent-300 mt-0.5 text-lg">&#10022;</span>
    <span>Build weekly meal plans in minutes</span>
  </li>
  <li class="flex items-start gap-3 text-primary-100/90">
    <span class="text-accent-300 mt-0.5 text-lg">&#10022;</span>
    <span>Track macros and stay on top of your goals</span>
  </li>
  <li class="flex items-start gap-3 text-primary-100/90">
    <span class="text-accent-300 mt-0.5 text-lg">&#10022;</span>
    <span>Smart grocery lists that save you time</span>
  </li>
  <li class="flex items-start gap-3 text-primary-100/90">
    <span class="text-accent-300 mt-0.5 text-lg">&#10022;</span>
    <span>Free to get started, no credit card required</span>
  </li>
<% end %>

<h2 class="text-3xl font-display font-bold text-warm-900 mb-2 text-center">Create your account</h2>
<p class="text-warm-500 mb-8 text-center">Start planning delicious keto meals today</p>

<%= form_with url: signup_path, method: :post, class: "space-y-6",
    data: { controller: "submit-button", action: "submit->submit-button#submit" } do |f| %>
  <div>
    <%= f.label :email_address, "Email address", class: "block text-sm font-semibold text-warm-700 mb-2" %>
    <%= f.email_field :email_address,
        required: true,
        autofocus: true,
        autocomplete: "email",
        class: "w-full px-5 py-3.5 border border-warm-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-warm-900 placeholder-warm-400 transition-shadow",
        placeholder: "you@example.com" %>
  </div>

  <div>
    <button type="submit"
        class="relative w-full bg-accent-500 text-white py-3.5 px-6 rounded-xl hover:bg-accent-600 focus:ring-2 focus:ring-accent-400 focus:ring-offset-2 font-semibold transition-colors cursor-pointer text-lg"
        data-submit-button-target="button">
      <span data-submit-button-target="label">Get started</span>
      <span data-submit-button-target="spinner" class="hidden absolute inset-0 flex items-center justify-center">
        <svg class="spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
      </span>
    </button>
  </div>
<% end %>

<div class="mt-8 pt-6 border-t border-warm-200 text-center">
  <p class="text-warm-500">
    Already have an account?
    <%= link_to "Sign in", new_session_path, class: "text-primary-600 hover:text-primary-700 font-semibold" %>
  </p>
</div>
