<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "MealSzn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Nunito+Sans:ital,opsz,wght@0,6..12,300;0,6..12,400;0,6..12,500;0,6..12,600;0,6..12,700;1,6..12,400&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <div class="min-h-screen flex flex-col lg:flex-row">
      <%# ── Hero Panel (left on desktop, top on mobile) ── %>
      <div class="relative overflow-hidden lg:w-[58%] flex-shrink-0 px-6 py-10 lg:px-16 lg:py-0 flex items-center"
           style="background: linear-gradient(155deg, #5c2b17 0%, #7d381c 30%, #a14722 60%, #c2582a 100%);
                  background-image: radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1px), linear-gradient(155deg, #5c2b17 0%, #7d381c 30%, #a14722 60%, #c2582a 100%);
                  background-size: 24px 24px, 100% 100%;">
        <%# Decorative floating food icons %>
        <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
          <span class="hero-float absolute text-4xl lg:text-5xl opacity-20 top-[12%] left-[8%]">🍳</span>
          <span class="hero-float-delayed absolute text-3xl lg:text-4xl opacity-15 top-[25%] right-[12%]">🥑</span>
          <span class="hero-float-slow absolute text-4xl lg:text-5xl opacity-20 bottom-[20%] left-[15%]">🧈</span>
          <span class="hero-float-delayed absolute text-3xl lg:text-4xl opacity-15 bottom-[35%] right-[8%]">🥩</span>
          <span class="hero-float absolute text-2xl lg:text-3xl opacity-10 top-[55%] left-[45%]">🫒</span>
        </div>

        <div class="relative z-10 max-w-lg mx-auto lg:mx-0 lg:ml-auto lg:mr-16">
          <%# Wordmark %>
          <h1 class="fade-up font-display font-bold text-white text-4xl sm:text-5xl lg:text-6xl tracking-tight mb-4">
            MealSzn
          </h1>

          <%# Tagline %>
          <p class="fade-up fade-up-delay-1 text-primary-200 text-lg sm:text-xl lg:text-2xl font-light mb-8">
            Meal planning for the whole family
          </p>

          <%# Value props — hidden on mobile for compact hero %>
          <ul class="hidden sm:block space-y-3 fade-up fade-up-delay-2">
            <% if content_for?(:hero_content) %>
              <%= yield :hero_content %>
            <% else %>
              <li class="flex items-start gap-3 text-primary-100/90">
                <span class="text-accent-300 mt-0.5 text-lg">&#10022;</span>
                <span>Plan keto-friendly meals your family will love</span>
              </li>
              <li class="flex items-start gap-3 text-primary-100/90">
                <span class="text-accent-300 mt-0.5 text-lg">&#10022;</span>
                <span>Import recipes from any website in seconds</span>
              </li>
              <li class="flex items-start gap-3 text-primary-100/90">
                <span class="text-accent-300 mt-0.5 text-lg">&#10022;</span>
                <span>Auto-generate grocery lists from your plan</span>
              </li>
              <li class="flex items-start gap-3 text-primary-100/90">
                <span class="text-accent-300 mt-0.5 text-lg">&#10022;</span>
                <span>AI-powered meal suggestions that fit your macros</span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <%# ── Form Panel (right on desktop, bottom on mobile) ── %>
      <div class="flex-1 bg-warm-gradient flex items-center justify-center px-6 py-10 lg:py-16">
        <div class="w-full max-w-md">
          <% if flash[:notice] %>
            <div class="mb-4 p-4 bg-green-50 border border-green-200 text-green-700 rounded-lg text-sm">
              <%= flash[:notice] %>
            </div>
          <% end %>

          <% if flash[:alert] %>
            <div class="mb-4 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
              <%= flash[:alert] %>
            </div>
          <% end %>

          <div class="card-warm rounded-2xl p-8 sm:p-10">
            <%= yield %>
          </div>

          <%# Minimal brand mark footer %>
          <p class="mt-8 text-center text-warm-400 text-xs tracking-wide">
            MealSzn &middot; Eat well, plan less
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
